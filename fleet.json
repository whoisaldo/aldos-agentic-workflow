{
  "$schema": "./fleet.schema.json",
  "schema_version": 1,
  "owner": "Your name",
  "state_dir": "~/Services/fleet-share",
  "gateway": {
    "url": "http://100.64.0.1:8317",
    "version": "8.0.16",
    "release_sha256": "b2c48e27b62bc94c71387e43be287c742b0336f21e2fe203568233593983d495",
    "runtime_dir": "~/Services/fleet-share-gateway",
    "service_label": "org.sharedfleet.fleet-gateway",
    "accounts_per_provider": 1,
    "expected_email": "your-email@example.com",
    "providers": [
      "claude",
      "codex"
    ]
  },
  "machines": {
    "devbox1": {
      "os": "macos",
      "user": "your-user",
      "address": "100.64.0.1",
      "ssh": "devbox1",
      "repo": "/Users/your-user/alis-shared-fleet",
      "roles": [
        "development",
        "macos",
        "ios",
        "browser",
        "blender",
        "gateway"
      ],
      "heavy_build_slots": 1
    },
    "mainpc": {
      "os": "windows",
      "user": "your-user",
      "address": "100.64.0.2",
      "ssh": "mainpc",
      "repo": "D:\\AgentWork\\fleet",
      "work_root": "D:\\AgentWork",
      "roles": [
        "windows",
        "gpu",
        "display"
      ],
      "heavy_build_slots": 1,
      "interactive_tests_require_login": true
    },
    "macbook-pro-2": {
      "os": "macos",
      "user": "your-user",
      "address": "100.64.0.3",
      "ssh": "macbook-pro-2",
      "repo": "/Users/your-user/alis-shared-fleet",
      "roles": [
        "control",
        "review"
      ]
    }
  },
  "profiles": {
    "personal-codex": {
      "driver": "codex",
      "identity": "personal",
      "home": "~/.codex",
      "managed": false
    },
    "personal-claude": {
      "driver": "claude",
      "identity": "personal",
      "home": "~/.claude",
      "managed": false
    },
    "fleet-codex": {
      "driver": "codex",
      "identity": "personal",
      "home": "~/.codex_fleet",
      "managed": true,
      "transport": "gateway",
      "model": "gpt-6-astra",
      "effort": "xhigh",
      "t3_instance": "codex_fleet"
    },
    "fleet-claude": {
      "driver": "claude",
      "identity": "personal",
      "home": "~/.claude_fleet",
      "managed": true,
      "transport": "gateway",
      "model": "claude-fable-5-1[1m]",
      "effort": "xhigh",
      "t3_instance": "claudeAgent_fleet"
    }
  },
  "protected_services": {
    "t3-desktop": {
      "ports": [
        3773
      ],
      "owner": "T3 Code Nightly desktop app"
    }
  },
  "additional_gateways": {},
  "skill_policy": {
    "personal_identities": [
      "personal"
    ]
  },
  "notify": {
    "host": "devbox1",
    "max_chars": 500,
    "max_sentences": 3,
    "interval_minutes": 30,
    "channels": [
      {
        "name": "discord",
        "type": "discord-webhook",
        "url": {
          "secret": "personal/FLEET_PAGE_DISCORD_WEBHOOK"
        }
      }
    ]
  },
  "secrets": {
    "host": "devbox1",
    "scopes": [
      "personal",
      "work"
    ]
  },
  "sync": {
    "host": "devbox1",
    "machines": [
      "mainpc",
      "macbook-pro-2"
    ],
    "interval_seconds": 120,
    "stale_after_minutes": 10,
    "service_label": "org.sharedfleet.skill-sync",
    "include_native": false,
    "shared_homes": []
  },
  "debug": {
    "claude": {
      "personal": {
        "home": "~/.claude",
        "email": "your-email@example.com",
        "login": "claudeai",
        "sso": false
      }
    }
  }
}
